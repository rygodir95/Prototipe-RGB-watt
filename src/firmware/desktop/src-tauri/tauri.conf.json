{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZoneGlow",
  "mainBinaryName": "ZoneGlow",
  "version": "0.1.0",
  "identifier": "com.zoneglow.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ZoneGlow — Training Zone Lighting",
        "width": 1180,
        "height": 860,
        "minWidth": 520,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}