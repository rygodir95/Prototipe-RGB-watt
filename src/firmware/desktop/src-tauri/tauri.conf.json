{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZoneGlow",
  "mainBinaryName": "ZoneGlow",
  "version": "0.2.1",
  "identifier": "com.zoneglow.desktop",
  "build": {
    "frontendDist": "generated-web",
    "beforeDevCommand": "npm run sync:web",
    "beforeBuildCommand": "npm run sync:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "generated-web": "web" }
  }
}