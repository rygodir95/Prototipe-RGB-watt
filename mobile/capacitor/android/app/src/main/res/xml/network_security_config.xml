<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ZoneGlow Hub runs on plain http://ws:// on the LAN. Allow cleartext
         for the whole app: it performs no sensitive/cloud traffic. For a
         production release, replace this with a pinned config that only
         allows your known Hub addresses. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
